// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================
// 👥 PROFILES - Perfiles de Usuario
// Almacena datos de usuarios autenticados (relacionado con auth.users de Supabase)
// =============================================
model Profile {
  id        String   @id @db.Uuid // FK a auth.users de Supabase
  username  String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  // Relaciones
  games Game[] @relation("CreatorGames")

  @@map("profiles")
}

// =============================================
// 🏷️ TEMPLATES - Plantillas de Puntuación
// Define la lógica de puntuación para distintos juegos
// =============================================
model Template {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String  @unique
  scoringSchema Json    @map("scoring_schema") @db.JsonB
  isPublic      Boolean @default(true) @map("is_public")

  // Relaciones
  games Game[]

  @@map("templates")
}

// =============================================
// 🏁 GAMES - Partidas
// Almacena los datos de cada partida
// =============================================
model Game {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  isFinished Boolean  @default(false) @map("is_finished")

  // Relaciones
  creatorId  String   @map("creator_id") @db.Uuid
  creator    Profile  @relation("CreatorGames", fields: [creatorId], references: [id])

  templateId String   @map("template_id") @db.Uuid
  template   Template @relation(fields: [templateId], references: [id])

  winnerId   String?  @map("winner_id") @db.Uuid
  winner     Player?  @relation("GameWinner", fields: [winnerId], references: [id])

  players    Player[] @relation("GamePlayers")

  @@map("games")
}

// =============================================
// 🎲 PLAYERS - Jugadores
// Participantes y su marcador en una partida específica
// =============================================
model Player {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  color      String
  totalScore Int    @default(0) @map("total_score")

  // Relaciones
  gameId String @map("game_id") @db.Uuid
  game   Game   @relation("GamePlayers", fields: [gameId], references: [id], onDelete: Cascade)

  moves Move[]

  // Partidas donde este jugador es el ganador
  wonGames Game[] @relation("GameWinner")

  @@map("players")
}

// =============================================
// 📝 MOVES - Movimientos / Historial
// Game Log para "Deshacer" y seguimiento de puntuación
// =============================================
model Move {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  pointsChange Int      @map("points_change")
  reason       String

  // Relaciones
  playerId String @map("player_id") @db.Uuid
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("moves")
}
